<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      com.google.mlkit:text-recognition transitively pulls in a telemetry/logging transport
      (com.google.android.datatransport:transport-backend-cct) that declares INTERNET and
      ACCESS_NETWORK_STATE, even though on-device OCR itself never needs network access. Strip
      both explicitly so "no image or extracted data may leave the phone" is enforced by the OS
      permission sandbox, not just policy — the app simply cannot make a network call.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gratuitinator">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gratuitinator"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider for the temp receipt-photo cache file passed to the system Camera app
          (intent-based capture). No CAMERA permission is needed for this approach, and this
          adds no network permission of any kind.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mwickes.gratuitinator.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>